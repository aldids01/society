{
    "name": "aldids/filament-db-sync",
    "description": "This package allow sync two different laravel filament app db",
    "keywords": [
        "aldids",
        "laravel",
        "filament-db-sync"
    ],
    "homepage": "https://github.com/aldids/filament-db-sync",
    "support": {
        "issues": "https://github.com/aldids/filament-db-sync/issues",
        "source": "https://github.com/aldids/filament-db-sync"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Nchandom Alpha Elias",
            "email": "nchandoms@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.8",
        "nunomaduro/larastan": "^3.9",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.43"
    },
    "autoload": {
        "psr-4": {
            "aldids\\FilamentDbSync\\": "src/",
            "aldids\\FilamentDbSync\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "aldids\\FilamentDbSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "aldids\\FilamentDbSync\\FilamentDbSyncServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
